#title-label {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 15px;
    width: 100%;
    color: rgba(255, 255, 255, 1);
    letter-spacing: 0.5px;
    text-shadow: 0px 1px 2px rgba(0, 0, 0, 0.5);
    padding-top: 2px;
    padding-bottom: 2px;
}


/* 参数端口 - 圆形样式 */
.parameter-port > #connector {
    background-color: rgba(100, 150, 255, 1) !important;
    border-color: rgba(80, 120, 220, 1) !important;
    border-width: 1px !important;
    border-radius: 50% !important;
}

.parameter-port > #connector:hover {
    background-color: rgba(120, 170, 255, 1) !important;
}

/* 确保输出端口容器始终靠右对齐 */
#output {
    flex-grow: 1;
    align-items: flex-end;
}


/* ========== Debug 可视化样式 ========== */

/* 断点暂停的节点 - 黄色边框 */
.debug-paused #node-border {
    border-width: 3px !important;
    border-color: rgba(255, 200, 0, 1) !important;
}

/* 本帧执行过的节点 - 绿色边框 */
.debug-executed #node-border {
    border-width: 2px !important;
    border-color: rgba(0, 220, 80, 0.9) !important;
}
