/* 自定义控制流端口样式 */
.control-flow-port {
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 2px;
    margin-right: 2px;
    padding: 0;
    min-height: 22px;
}

/* 端口名称标签样式 */
.control-flow-port > #type {
    color: rgb(242, 199, 115);
    font-size: 11px;
    padding-left: 4px;
    padding-right: 4px;
}

/* 其他标签样式 */
.control-flow-port > Label {
    color: rgb(242, 199, 115);
    font-size: 11px;
    padding-left: 4px;
    padding-right: 4px;
}

/* 
注意：connector的菱形样式必须在ControlFlowPort.cs中设置
因为Unity的Port默认使用内联样式，USS无法覆盖
*/

