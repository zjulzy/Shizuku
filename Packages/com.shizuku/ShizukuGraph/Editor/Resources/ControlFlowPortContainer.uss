/* 控制流端口容器主样式 */
.control-flow-container {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 28px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-bottom: 3px;
    background-color: rgba(12, 14, 18, 0.34);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

/* 左右侧端口容器 */
.port-side-container {
    flex-direction: row;
    align-items: center;
}

/* 右侧容器特殊样式 */
.port-right-container {
    justify-content: flex-end;
}

/* 多出口节点改为右侧纵向排列，避免把所有控制流出口挤在同一横行。 */
.control-flow-container.stacked-output {
    align-items: flex-start;
}

.port-right-container.stacked-output {
    flex-direction: column;
    align-items: flex-end;
}


